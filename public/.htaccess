DirectoryIndex index.php index.html

<IfModule mod_rewrite.c>
    <IfModule mod_negotiation.c>
        Options -MultiViews -Indexes
    </IfModule>

    RewriteEngine On

    # Do not publish local backups, test pages, or hidden configuration files.
    RewriteRule (^|/)\.(?!well-known(?:/|$)) - [F,L]
    RewriteRule ^(?:admin_test\.html|.*\.bak|hot)$ - [F,L,NC]

    RewriteCond %{HTTP:Authorization} .
    RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]

    RewriteCond %{HTTP:X-XSRF-TOKEN} .
    RewriteRule .* - [E=HTTP_X_XSRF_TOKEN:%{HTTP:X-XSRF-TOKEN}]

    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteRule ^ index.php [L]
</IfModule>

<IfModule mod_headers.c>
    # Progressive audio streaming with Byte Ranges
    <FilesMatch "\.(mp3|wav|ogg|m4a)$">
        Header set Accept-Ranges bytes
        Header set Cache-Control "public, max-age=604800"
    </FilesMatch>

    # Long-term caching for static images, web fonts, and favicons
    <FilesMatch "\.(webp|jpg|jpeg|png|gif|svg|ico|woff2?|ttf|eot)$">
        Header set Cache-Control "public, max-age=2592000, immutable"
    </FilesMatch>

    # Cache CSS and JS with revalidation
    <FilesMatch "\.(css|js)$">
        Header set Cache-Control "public, max-age=86400, stale-while-revalidate=604800"
    </FilesMatch>
</IfModule>
