DirectoryIndex index.php index.html

<IfModule mod_rewrite.c>
    <IfModule mod_negotiation.c>
        Options -MultiViews -Indexes
    </IfModule>

    RewriteEngine On

    # ----------------------------------------------------------------------
    # Clean URL Security & SEO: Enforce extensionless URLs (strip .html)
    # ----------------------------------------------------------------------
    # 1. Canonical redirect /keunggulan and /keunggulan.html to /bisnis
    RewriteCond %{THE_REQUEST} \s/keunggulan(?:\.html)?[\s?] [NC]
    RewriteRule ^ /bisnis [R=301,L]

    # 2. Canonical redirect /bisnis.html to /bisnis
    RewriteCond %{THE_REQUEST} \s/bisnis\.html[\s?] [NC]
    RewriteRule ^ /bisnis [R=301,L]

    # 3. Canonical redirect /index.html to /
    RewriteCond %{THE_REQUEST} \s/index\.html[\s?] [NC]
    RewriteRule ^ / [R=301,L]

    # 4. Canonical redirect any other *.html (e.g. /login.html -> /login)
    RewriteCond %{THE_REQUEST} \s/+(.+?)\.html[\s?] [NC]
    RewriteRule ^ /%1 [R=301,L]

    # Do not publish local backups, test pages, or hidden configuration files.
    RewriteRule (^|/)\.(?!well-known(?:/|$)) - [F,L]
    RewriteRule ^(?:admin_test\.html|.*\.bak|hot)$ - [F,L,NC]

    RewriteCond %{HTTP:Authorization} .
    RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]

    RewriteCond %{HTTP:X-XSRF-TOKEN} .
    RewriteRule .* - [E=HTTP_X_XSRF_TOKEN:%{HTTP:X-XSRF-TOKEN}]

    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteRule ^ index.php [L]
</IfModule>

<IfModule mod_headers.c>
    # Progressive audio streaming with Byte Ranges
    <FilesMatch "\.(mp3|wav|ogg|m4a)$">
        Header set Accept-Ranges bytes
        Header set Cache-Control "public, max-age=604800"
    </FilesMatch>

    # Long-term caching for static images, web fonts, and favicons
    <FilesMatch "\.(webp|jpg|jpeg|png|gif|svg|ico|woff2?|ttf|eot)$">
        Header set Cache-Control "public, max-age=2592000, immutable"
    </FilesMatch>

    # Cache CSS and JS with revalidation
    <FilesMatch "\.(css|js)$">
        Header set Cache-Control "public, max-age=86400, stale-while-revalidate=604800"
    </FilesMatch>
</IfModule>
